{
  "name": "@mrzhaobh/dsh-session-stars",
  "version": "1.0.0",
  "private": true,
  "description": "Star sidebar sessions with one click: a hover star on each row and a mark on starred rows. Uses the built-in workspace row slots, so it never replaces a built-in plugin.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.2-rc.5"
    },
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshMarket": {
    "category": "sidebar",
    "labels": [
      "uses-slots",
      "zero-config",
      "local-data"
    ],
    "keywords": [
      "star",
      "favorite",
      "bookmark",
      "session list",
      "sidebar",
      "星标",
      "收藏",
      "会话"
    ]
  },
  "scripts": {
    "test": "node test/stars.test.mjs"
  },
  "license": "MIT"
}
