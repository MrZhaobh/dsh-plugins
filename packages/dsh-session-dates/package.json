{
  "name": "@mrzhaobh/dsh-session-dates",
  "version": "1.1.0",
  "private": true,
  "description": "Adds date headings to the built-in sidebar's recently updated flat session list.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.2-rc.5"
    },
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshMarket": {
    "category": "sidebar",
    "labels": [
      "uses-slots",
      "zero-config"
    ],
    "keywords": [
      "sidebar",
      "session date",
      "day groups",
      "日期分组",
      "按天"
    ]
  },
  "scripts": {
    "test": "node test/dates.test.mjs"
  },
  "license": "MIT"
}
