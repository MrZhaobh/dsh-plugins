{
  "name": "@mrzhaobh/dsh-sidebar-day-groups",
  "version": "2.0.0",
  "private": true,
  "description": "Sidebar day groups for DeepSeek Harness: sessions sectioned under today, yesterday, and exact dates. Ported onto the installed ui-workspace bundle by four targeted edits, not a full patch replay.",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "vendor",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.2-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshMarket": {
    "category": "sidebar",
    "labels": [
      "builtin-fork",
      "needs-restart"
    ],
    "keywords": [
      "sidebar",
      "session list",
      "group by day",
      "day groups",
      "date sections",
      "按天分组",
      "日期分段",
      "今天",
      "昨天"
    ]
  },
  "scripts": {
    "test": "node test/day-groups.test.mjs",
    "check": "node scripts/port-day-groups.mjs --check",
    "port": "node scripts/port-day-groups.mjs",
    "refresh": "node scripts/refresh.mjs"
  },
  "license": "MIT"
}
