{
  "name": "@mrzhaobh/dsh-sidebar-day-groups",
  "version": "1.0.0",
  "private": true,
  "description": "Sidebar day groups, one-click stars, and a pinned section for DeepSeek Harness, delivered as a patched fork of the built-in workspace plugin.",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "vendor",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": "0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshMarket": {
    "category": "sidebar",
    "labels": [
      "builtin-fork",
      "version-pinned",
      "needs-restart"
    ],
    "keywords": [
      "sidebar",
      "session list",
      "group by day",
      "star",
      "favorite",
      "pinned",
      "按天分组",
      "星标",
      "置顶"
    ]
  },
  "scripts": {
    "test": "node scripts/test-day-groups.mjs && node scripts/test-stars.mjs",
    "check": "node scripts/refresh.mjs --check",
    "refresh": "node scripts/refresh.mjs",
    "make-patch": "node scripts/make-patch.mjs",
    "live-check": "node scripts/live-check.mjs"
  },
  "license": "MIT"
}
