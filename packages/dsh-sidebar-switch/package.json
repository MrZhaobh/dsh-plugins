{
  "name": "@mrzhaobh/dsh-sidebar-switch",
  "version": "1.0.0",
  "private": true,
  "description": "A sidebar button that switches the session list between the built-in view and @mrzhaobh/dsh-sidebar-day, by enabling or disabling that plugin's loader row.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.2-rc.5"
    },
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshMarket": {
    "exclude": true,
    "category": "sidebar",
    "labels": [
      "uses-slots",
      "zero-config"
    ],
    "keywords": [
      "sidebar",
      "switch",
      "toggle",
      "切换",
      "按天分组"
    ]
  },
  "scripts": {
    "test": "node test/switch.test.mjs"
  },
  "license": "MIT"
}
