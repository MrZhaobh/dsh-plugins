    {
      "name": "@mrzhaobh/dsh-composer-heal",
      "title": {
        "en": "Composer self-heal",
        "zh": "输入框自愈"
      },
      "description": {
        "en": "Reloads the page when a session is open but the composer has disappeared, and appends what it saw to ~/.dsh/logs/composer-heal.jsonl so the original crash can be diagnosed later. At most three automatic reloads per ten minutes, then it stops and shows a notice.",
        "zh": "会话已打开但输入框消失时自动重载页面，并把现场追加写入 ~/.dsh/logs/composer-heal.jsonl，方便事后定位真正的崩溃原因。10 分钟内最多自动重载 3 次，超过就停手并在右下角挂一条提示，不会刷新死循环。"
      },
      "author": "MrZhaobh",
      "homepage": "https://github.com/MrZhaobh/dsh-plugins/tree/main/packages/dsh-composer-heal",
      "repository": {
        "url": "https://github.com/MrZhaobh/dsh-plugins",
        "directory": "packages/dsh-composer-heal"
      },
      "icon": "packages/dsh-composer-heal/icon.svg",
